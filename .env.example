# MemoRecipe — Docker Compose production environment variables
# These variables are consumed by docker-compose.prod.yml via
# ${VAR} interpolation. Copy this file to .env and replace all
# CHANGE_ME placeholders before running `docker compose up`.
# .env is gitignored (never commit real secrets).
#
# NOTE: Sensitive values (Postgres password, JWT signing key, OCR URL,
# Telegram credentials, connection strings) are NOT stored here — they
# live as one-file-per-secret under ${SECRETS_PATH} and are mounted
# read-only into containers at /run/secrets/*. See documentation/DEPLOYMENT.md
# section "Secret management (production)" for the setup procedure.

# --- PostgreSQL non-secret settings ---
# Used to initialize the postgres container. The password is provided
# separately as a file secret (postgres_password) — see DEPLOYMENT.md.
POSTGRES_USER=memorecipe
POSTGRES_DB=memorecipe

# --- JWT claims (Issuer and Audience) ---
# Not sensitive — these are the values embedded in every issued token.
# Should match your production domain in prod.
JWT_ISSUER=MemoRecipe
JWT_AUDIENCE=MemoRecipeUsers

# --- Image tags (GHCR registry) ---
# Specifies which image versions to pull from GHCR.
# Use semantic versioning (v0.1.0, v0.2.0, etc.) in prod for reproducibility.
# 'latest' is acceptable for dev/test but NOT recommended in prod
# (rollback impossible, "ca marchait hier" syndrome).
# To rollback: change the tag here + run `docker compose pull && up -d`.
API_IMAGE_TAG=v0.1.1
WEB_IMAGE_TAG=v0.1.0

# --- Secrets directory (host path) ---
# Absolute path on the VPS where the one-file-per-secret files live.
# Docker Compose mounts them read-only under /run/secrets/* in each container.
# The directory itself must be owner-only (chmod 700), each file chmod 400.
# See DEPLOYMENT.md "Secret management (production)" for the setup script.
SECRETS_PATH=/opt/memorecipe/secrets

# --- GPG recipient for encrypted backups ---
# The email (or key identifier) associated with the GPG public key baked
# into the backup image (infra/backup/memorecipe-backup-pubkey.asc). The
# backup script uses `gpg --encrypt --recipient ${GPG_RECIPIENT}`.
# Must match the uid of the public key or gpg will refuse to encrypt.
GPG_RECIPIENT=backup@your-domain

# --- Alerting thresholds — OPTIONAL ---
# All thresholds default to sane values in AlertingOptions.cs.
# Uncomment below to override per environment.
# Format for TimeSpan: "hh:mm:ss" or "d.hh:mm:ss".
#
# Mass purge alert threshold (nb of accounts purged in one batch)
#ALERTING_MASS_PURGE_CRITICAL=10
#
# Login fail storm (nb of failed logins) + rolling window
#ALERTING_LOGIN_FAIL_STORM_CRITICAL=50
#ALERTING_LOGIN_FAIL_STORM_WINDOW=00:05:00
#
# Server error spike (nb of HTTP 500) + rolling window
#ALERTING_SERVER_ERROR_SPIKE_CRITICAL=20
#ALERTING_SERVER_ERROR_SPIKE_WINDOW=00:05:00
#
# Backup staleness (path monitored + max age before alert)
#ALERTING_BACKUP_PATH=/backups
#ALERTING_BACKUP_STALE_AFTER=26:00:00
