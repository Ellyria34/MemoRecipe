# =============================================================================
# DEV (used by docker-compose.yml)
# =============================================================================

# Postgres (same DB name/user in dev and prod, only password differs)
POSTGRES_USER=memorecipe
POSTGRES_DB=memorecipe
POSTGRES_PASSWORD=CHANGE_ME_DEV_ONLY

# pgAdmin (dev only - not deployed to prod)
PGADMIN_DEFAULT_EMAIL=admin@example.local
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_DEV_ONLY

# =============================================================================
# PROD (used by docker-compose.prod.yml)
# Prod POSTGRES_PASSWORD uses Docker Secrets, not env var (see SECRETS_PATH)
# =============================================================================

# JWT (must match production domain)
JWT_ISSUER=https://app.memorecipe.com
JWT_AUDIENCE=https://app.memorecipe.com

# Image tags to pull from GHCR
API_IMAGE_TAG=v1.0.0-alpha.3
WEB_IMAGE_TAG=v1.0.0-alpha.3

# GPG recipient for encrypted backups (public key must be imported on VPS)
GPG_RECIPIENT=CHANGE_ME_GPG_EMAIL

# Docker Secrets absolute path on the host (must exist and contain the secret files)
SECRETS_PATH=/opt/memorecipe/secrets
