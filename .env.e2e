# E2E test environment variables — DUMMY VALUES, NEVER USE IN PRODUCTION
# These values are tracked in git intentionally for reproducibility.
# Real production secrets live in files under SECRETS_PATH (see DEPLOYMENT.md).

# ===== Postgres (ephemeral DB for E2E) =====
POSTGRES_USER=e2e
POSTGRES_PASSWORD=e2e-test-not-for-prod
POSTGRES_DB=memorecipe_e2e

# ===== JWT =====
JwtSettings__Issuer=e2e-issuer
JwtSettings__Audience=e2e-audience
JwtSettings__Secret=e2e-jwt-secret-min-32-chars-non-production-only-test-values

# ===== ConnectionString (references POSTGRES_* above) =====
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=memorecipe_e2e;Username=e2e;Password=e2e-test-not-for-prod

# ===== OcrScan (points to local ia container in the e2e compose) =====
OcrScan__BaseUrl=http://ia:7071
OcrScan__FunctionKey=e2e-fake-function-key-unused-in-fake-mode

# ===== Telegram (never called in Fake mode, dummy values) =====
Telegram__BotToken=e2e-fake-telegram-token
Telegram__ChatId=e2e-fake-telegram-chat-id

# ===== IA Provider (activate Fake) =====
AI_PROVIDER=Fake

# ===== ASP.NET Core =====
ASPNETCORE_ENVIRONMENT=Production
Cors__AllowedOrigins__0=http://localhost:8080