{
  // Display name shown at bottom-left of VSCode when connected
  "name": "MemoRecipe DevContainer",

  // Build from local Dockerfile in the same folder
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },

  // Additional tools installed AFTER the image build, via official Microsoft features
  // (safer than manual Dockerfile install: signed, versioned, maintained by Microsoft)
  "features": {
    // Add .NET 8 SDK alongside the .NET 10 SDK already in the base image
    // Required to build and run the memoRecipe-ia Azure Functions project
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "none",
      "additionalVersions": "8.0"
    },
    // Node.js 20 LTS (required by Azure Functions Core Tools)
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    // Azure Functions Core Tools v4 CLI (the "func" command)
    // Used to run the Function locally with "func start" if debugging outside the compose service
    "ghcr.io/devcontainers/features/azure-functions-core-tools:1": {}
  },

  // Ports forwarded from container to host machine
  // Allows the host browser to reach services running inside the container
  "forwardPorts": [
    5131,
    5432,
    5050,
    7071
  ],

  // VSCode customization: extensions auto-installed + settings
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-azuretools.vscode-docker",
        "eamodio.gitlens",
        "yzhang.markdown-all-in-one",
        "davidanson.vscode-markdownlint",
        "editorconfig.editorconfig"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  },

  // Non-root user for the dev session (defense in depth)
  "remoteUser": "vscode",

  // Workspace mount point inside the container
  // VSCode mounts the local repo directory at this path
  "workspaceFolder": "/workspaces/MemoRecipe"
}